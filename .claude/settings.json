      "mcp__spectex__spectex_get_shared_types",
      "mcp__spectex__spectex_get_snapshot",
      "mcp__spectex__spectex_get_sources",
      "mcp__spectex__spectex_get_symbol_docs",
      "mcp__spectex__spectex_get_test_coverage",
      "mcp__spectex__spectex_help",
