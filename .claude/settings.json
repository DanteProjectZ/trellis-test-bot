{
  "crossSessionInbound": "refuse",
  "env": {
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0"
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "superpowers@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers",
        "ref": "v7.0.1"
      },
      "autoUpdate": false
    }
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [],
      "allowUnixSockets": []
    },
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.trellis-flow/**)",
      "Read(/**/.env*)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(/**/.git/hooks/**)",
      "Edit(/**/.git/config)",
      "Edit(/**/.git/info/**)",
      "Edit(/**/.git/config.worktree)",
      "Edit(/**/.git/refs/replace/**)",
      "Edit(/**/.git/objects/info/alternates)",
      "Edit(/skills-lock.json)",
      "Edit(/.spectex/config*.json)",
      "Edit(/.spectex/memory.db*)",
      "Edit(/.spectex/vectors/memories.lance/**)",
      "Edit(/.spectex/vectors/failures.lance/**)",
      "Edit(/.spectex/skills/**)",
      "Edit(/.spectex/work_log.db*)",
      "Edit(/.trellis/**)",
      "Edit(/.trellis/catalog/**)",
      "Edit(/workflow/trellis.yaml)",
      "Edit(/workflow/install-manifest.json)",
      "Edit(/workflow/bin/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.agents/skills/**)",
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh repo:*)",
      "Bash(trellis anchor *)",
      "Bash(trellis user-settings *)",
      "Bash(trellis decisions*)",
      "Bash(npx trellis-flow decisions*)",
      "Bash(npx *trellis-flow* anchor*)",
      "Bash(npx *trellis-flow* user-settings*)",
      "Bash(npx *trellis-flow* decisions*)",
      "Bash(spectex save*)",
      "Bash(spectex knowledge*)",
      "Bash(spectex import*)",
      "Bash(spectex plan*)",
      "Bash(spectex * save*)",
      "Bash(spectex --root * save*)",
      "mcp__claude-in-chrome",
      "mcp__plugin_ecc_github",
      "mcp__github",
      "mcp__plugin_github_github",
      "mcp__spectex__spectex_edit_symbol",
      "mcp__spectex__spectex_rename_symbol",
      "mcp__spectex__spectex_index",
      "mcp__spectex__spectex_delete_memory",
      "mcp__spectex__spectex_import_knowledge",
      "mcp__spectex__spectex_export_knowledge",
      "mcp__spectex__spectex_set_compass",
      "mcp__spectex__spectex_save",
      "mcp__spectex__spectex_save_snapshot",
      "mcp__spectex__spectex_update_status",
      "mcp__spectex__spectex_sync_plan",
      "mcp__spectex__spectex_verify_qa",
      "mcp__spectex__spectex_session",
      "mcp__spectex__spectex_recall_chats",
      "mcp__spectex__spectex_get_chat_md",
      "mcp__spectex__spectex_get_collab_context",
      "mcp__spectex__spectex_summarize_thread",
      "mcp__spectex__spectex_symbol_knowledge",
      "mcp__spectex__spectex_review_doc_links",
      "mcp__spectex__spectex_detect_gaps",
      "mcp__spectex__spectex_detect_contradictions",
      "mcp__spectex__spectex_get_resource_usage"
    ],
    "ask": [
      "WebFetch",
      "Edit(/**/.claude/**)",
      "Edit(/**/.mcp.json)",
      "Edit(/**/.agents/skills/**)",
      "Edit(/**/AGENTS.md)",
      "Edit(/**/CLAUDE.md)",
      "mcp__spectex__spectex_query_graph",
      "mcp__spectex__spectex_get_skill",
      "mcp__spectex__spectex_list_skills"
    ],
    "allow": [
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:go.dev)",
