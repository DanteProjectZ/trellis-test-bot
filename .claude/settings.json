      "WebFetch(domain:code.claude.com)",
      "Skill(tr-ship)",
      "Workflow(tr-ship)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__spectex__spectex_check_staleness",
      "mcp__spectex__spectex_explain_symbol",
      "mcp__spectex__spectex_get_360_context",
      "mcp__spectex__spectex_get_api_contracts",
      "mcp__spectex__spectex_get_blast_radius",
      "mcp__spectex__spectex_get_changelog",
      "mcp__spectex__spectex_get_clusters",
      "mcp__spectex__spectex_get_code_health",
      "mcp__spectex__spectex_get_compass",
      "mcp__spectex__spectex_get_contract_bridge",
      "mcp__spectex__spectex_get_cross_source_contracts",
      "mcp__spectex__spectex_get_cross_source_links",
      "mcp__spectex__spectex_get_db_schema",
      "mcp__spectex__spectex_get_doc_code_links",
      "mcp__spectex__spectex_get_doc_section",
      "mcp__spectex__spectex_get_doc_staleness",
      "mcp__spectex__spectex_get_entity_map",
      "mcp__spectex__spectex_get_entry_points",
      "mcp__spectex__spectex_get_git_context",
      "mcp__spectex__spectex_get_issue",
      "mcp__spectex__spectex_get_memory",
      "mcp__spectex__spectex_get_plan_progress",
      "mcp__spectex__spectex_get_pr_analysis",
